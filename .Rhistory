mutate(
escala_izq_der = case_when(escala_izq_der >= 0 &
escala_izq_der <= 3 ~ "Izquierda",
escala_izq_der >= 4 &
escala_izq_der <= 6 ~ "Centro",
escala_izq_der >= 7 &
escala_izq_der <= 10 ~ "Derecha",
TRUE ~ "Ninguno"
)
)
