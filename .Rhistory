library(broom)
library(dplyr)
library(knitr)
library(kableExtra)
tabla_lineal <- bind_rows(
tidy(modelo_lineal_1) %>% mutate(modelo = "Modelo 1"),
tidy(modelo_lineal_2) %>% mutate(modelo = "Modelo 2"),
tidy(modelo_lineal_3) %>% mutate(modelo = "Modelo 3")
) %>%
mutate(
term = recode(
term,
"(Intercept)" = "Constante",
"posicion_politicaCentro" = "Centro",
"posicion_politicaDerecha" = "Derecha",
"sexoMujer" = "Mujer",
"escala_izq_der" = "Escala izquierda-derecha"
),
resultado = paste0(
round(estimate, 3),
case_when(
p.value < 0.001 ~ "***",
p.value < 0.01 ~ "**",
p.value < 0.05 ~ "*",
TRUE ~ ""
),
" (",
round(std.error, 3),
")"
)
) %>%
select(modelo, term, resultado) %>%
pivot_wider(
names_from = modelo,
values_from = resultado
)
